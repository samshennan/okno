# Okno Environment Variables (1Password References)
# These are SECRET REFERENCES, not actual secrets
# 1Password CLI injects real values at runtime

GOOGLE_CLIENT_ID="op://Private/Okno Google OAuth/add more/client_id"
GOOGLE_CLIENT_SECRET="op://Private/Okno Google OAuth/add more/client_secret"
SESSION_SECRET="op://Private/Okno Session Secret/password"
