# Nginx configuration for Okno backend
# Deploy this to: /etc/nginx/sites-available/okno
# Then: sudo ln -s /etc/nginx/sites-available/okno /etc/nginx/sites-enabled/
#
# Domain: okno.moonacle.com (Squarespace DNS)
# VPS IP: 159.69.152.123 (Hetzner)

# Initial HTTP config for Let's Encrypt verification
server {
    listen 80;
    server_name okno.moonacle.com;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}

# After running certbot, it will auto-add HTTPS server block here
